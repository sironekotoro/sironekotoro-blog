{
  "name": "sironekotoro-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "migrate:sample": "node scripts/migrate-mt.mjs --sample 8 --download-images",
    "migrate:sample:offline": "node scripts/migrate-mt.mjs --sample 8",
    "migrate:full": "node scripts/migrate-full.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run migrate:sample && npm test && npm run check && npm run build && node scripts/check-built-site.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.1",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.2.0",
    "@types/sanitize-html": "2.16.1",
    "typescript": "6.0.3"
  }
}
